{
  "name": "nutreluma-native",
  "version": "1.0.1",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.21",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-device": "^57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.7.1",
    "react-native-purchases-ui": "^10.7.1",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "eas-build-pre-install": "node scripts/bump-version.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false",
    "eas:init": "npx eas-cli init",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "build:android:production": "node scripts/bump-version.js && node scripts/eas-cli.mjs build --platform android --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production"
  },
  "private": true
}
