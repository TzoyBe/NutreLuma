####################################################################
# NutreLuma - παράδειγμα μεταβλητών περιβάλλοντος
# Αντίγραψέ το σε .env  ->  cp .env.example .env
# ΜΗΝ κάνεις commit το .env
####################################################################

NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- PostgreSQL -------------------------------------------------
POSTGRES_USER=nutreluma_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nutreluma_app
# Το host "db" είναι το όνομα του service στο docker-compose.
DATABASE_URL=postgresql://nutreluma_user:change_me@db:5432/nutreluma_app

# --- Authentication ---------------------------------------------
# Παράγωγε τυχαία τιμή:  openssl rand -base64 48
AUTH_SECRET=replace_with_secure_random_value
SESSION_MAX_AGE_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Vision provider -----------------------------------------
# AI_PROVIDER: anthropic | openai | gemini | mock
# gemini -> Google AI Studio (δωρεάν tier). AI_API_BASE_URL:
#   https://generativelanguage.googleapis.com/v1beta   (το /openai προστίθεται αυτόματα)
#   Παράδειγμα μοντέλου: gemini-3.6-flash
# Το "mock" επιτρέπει πλήρη λειτουργία χωρίς API key (ντετερμινιστικά demo δεδομένα).
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=60000

# --- Storage / uploads ------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Rate limits ------------------------------------------------
MAX_AI_REQUESTS_PER_HOUR=20
MAX_UPLOADS_PER_DAY=50
MAX_LOGIN_ATTEMPTS_PER_15MIN=8

# --- Email (επαναφορά κωδικού) -----------------------------------
# EMAIL_PROVIDER: log | brevo | resend
#   log    -> δεν στέλνει τίποτα· γράφει το μήνυμα (και τον σύνδεσμο) στα logs.
#             Πλήρως λειτουργικό για δοκιμή χωρίς λογαριασμό σε πάροχο:
#             docker compose logs web | grep email_not_sent
#   brevo  -> https://app.brevo.com  (300 email/ημέρα δωρεάν, δεδομένα σε ΕΕ)
#   resend -> https://resend.com     (3.000/μήνα δωρεάν)
#
# ΜΗΝ στήσεις δικό σου mail server: οι IP των VPS/οικιακών συνδέσεων είναι
# προεπιλεγμένα σε blocklists και τα emails καταλήγουν στα ανεπιθύμητα.
EMAIL_PROVIDER=log
EMAIL_API_KEY=
# Πρέπει να ανήκει σε domain που έχεις επαληθεύσει στον πάροχο.
EMAIL_FROM=
EMAIL_FROM_NAME=NutreLuma
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24

# Optional: Expo push access token, if push security is enabled in Expo.
EXPO_ACCESS_TOKEN=

# --- Διατροφικοί στόχοι ------------------------------------------
# Προεπιλεγμένος ημερήσιος στόχος νερού όταν ο χρήστης δεν έχει ορίσει δικό του.
DEFAULT_DAILY_WATER_TARGET_ML=2500

# --- Λοιπά ------------------------------------------------------
DEFAULT_LOCALE=el
DEFAULT_TIMEZONE=Europe/Athens
LOG_LEVEL=info

# --- Seed (προαιρετικό) -----------------------------------------
# Αν δεν οριστεί, το seed script παράγει τυχαίο password και το τυπώνει μία φορά.
SEED_DEMO_EMAIL=demo@nutreluma.local
SEED_DEMO_PASSWORD=

# --- Συνδρομές ---------------------------------------------------
BILLING_ENABLED=true
TRIAL_DAYS=3
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_ORIGINAL_PRICE_CENTS=399
SUBSCRIPTION_DISCOUNT_PERCENT=25
SUBSCRIPTION_PRICE_CENTS=299
SUBSCRIPTION_YEARLY_ORIGINAL_PRICE_CENTS=3999
SUBSCRIPTION_YEARLY_PRICE_CENTS=1999
SUBSCRIPTION_COUPON_CODES=
SUBSCRIPTION_COUPON_PRICE_CENTS=199

# Το ΠΡΟΘΕΜΑ του κλειδιού ορίζει το περιβάλλον:
#   sk_test_… -> δοκιμή (καμία πραγματική χρέωση)
#   sk_live_… -> ΠΡΑΓΜΑΤΙΚΑ ΧΡΗΜΑΤΑ
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_COUPON_PROMOTION_CODE_ID=

# --- PayPal (προαιρετικό, 2ος τρόπος πληρωμής) --------------------
# Το CLIENT_ID είναι δημόσιο εκ σχεδιασμού (μπαίνει στο JS του browser).
# Το CLIENT_SECRET ΔΕΝ φεύγει ποτέ από τον server — χωρίς αυτό δεν μπορούμε να
# επαληθεύσουμε τη συνδρομή και η επιλογή PayPal δεν εμφανίζεται καθόλου.
# PAYPAL_ENV: sandbox (δοκιμή) | live (ΠΡΑΓΜΑΤΙΚΑ ΧΡΗΜΑΤΑ)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=P-6E648426P5889944ANJ6QOYY
PAYPAL_COUPON_PLAN_ID=
PAYPAL_ENV=sandbox
# Personal intelligence feature flags (set any to false to disable)
PERSONAL_CALIBRATION=true
BEFORE_AFTER_SCAN=true
DATA_CONFIDENCE=true
PERSONAL_PATTERNS=true
ENERGY_ESTIMATE=true
WEIGHT_EXPLAINER=true
CAN_I_EAT_THIS=true
FIX_MY_DAY=true
FLEXIBLE_WEEKLY_BUDGET=true
PLATE_CALIBRATION=true
DAILY_RECIPE_PLAN=true
MAX_DAILY_RECIPE_PLANS=3
